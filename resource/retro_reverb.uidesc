<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
  <colors>
    <color name="Background" rgba="#05070aff"/>
    <color name="Text" rgba="#e7edf3ff"/>
    <color name="Muted" rgba="#9aaebeff"/>
    <color name="PanelTitle" rgba="#bed6eaff"/>
    <color name="Display" rgba="#07111aff"/>
    <color name="DisplayText" rgba="#dce9f3ff"/>
    <color name="Edge" rgba="#31506aff"/>
  </colors>
  <template background-color="Background" class="CViewContainer" maxSize="930, 410" minSize="930, 410" mouse-enabled="true" name="view" opacity="1" origin="0, 0" size="930, 410" transparent="false">
    <view class="CView" custom-view-name="RetroFaceplate" origin="0, 0" size="930, 410" mouse-enabled="false"/>
    <view class="CView" custom-view-name="BrandLogo" origin="26, 15" size="124, 62" mouse-enabled="false"/>
    <view class="CTextLabel" origin="283, 20" size="370, 32" title="125A RETRO REVERB" transparent="true" back-color="Background" font="~ NormalFontBig" font-color="Text" frame-width="0" text-alignment="center"/>
    <view class="CTextLabel" origin="282, 53" size="370, 17" title="ORIGINAL FREEVERB / 2000" transparent="true" back-color="Background" font="~ NormalFontSmall" font-color="Muted" frame-width="0" text-alignment="center"/>
    <view class="CTextLabel" origin="800, 121" size="100, 24" title="MASTER" transparent="true" back-color="Background" font="~ NormalFontSmall" font-color="PanelTitle" frame-width="0" text-alignment="center"/>

    <view class="CTextLabel" origin="56, 143" size="125, 24" title="Size" font="~ NormalFontSmall" font-color="Text" back-color="Background" frame-width="0" text-alignment="center" transparent="true"/>
    <view class="CView" custom-view-name="Size" origin="56, 176" size="125, 125"/>
    <view class="CTextEdit" control-tag="Size" origin="78, 320" size="82, 30" font="~ NormalFontSmall" font-color="DisplayText" back-color="Display" frame-color="Edge" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center"/>

    <view class="CTextLabel" origin="238, 143" size="125, 24" title="Damping" font="~ NormalFontSmall" font-color="Text" back-color="Background" frame-width="0" text-alignment="center" transparent="true"/>
    <view class="CView" custom-view-name="Damping" origin="238, 176" size="125, 125"/>
    <view class="CTextEdit" control-tag="Damping" origin="260, 320" size="82, 30" font="~ NormalFontSmall" font-color="DisplayText" back-color="Display" frame-color="Edge" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center"/>

    <view class="CTextLabel" origin="420, 143" size="125, 24" title="Width" font="~ NormalFontSmall" font-color="Text" back-color="Background" frame-width="0" text-alignment="center" transparent="true"/>
    <view class="CView" custom-view-name="Width" origin="420, 176" size="125, 125"/>
    <view class="CTextEdit" control-tag="Width" origin="442, 320" size="82, 30" font="~ NormalFontSmall" font-color="DisplayText" back-color="Display" frame-color="Edge" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center"/>

    <view class="CTextLabel" origin="602, 143" size="125, 24" title="Mix" font="~ NormalFontSmall" font-color="Text" back-color="Background" frame-width="0" text-alignment="center" transparent="true"/>
