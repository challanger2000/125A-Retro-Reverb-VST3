    <view class="CTextEdit" control-tag="Mix" origin="624, 320" size="82, 30" font="~ NormalFontSmall" font-color="DisplayText" back-color="Display" frame-color="Edge" frame-width="1" style-round-rect="true" round-rect-radius="5" text-alignment="center"/>

    <view class="CTextLabel" origin="794, 167" size="110, 24" title="Enable" font="~ NormalFontSmall" font-color="Text" back-color="Background" frame-width="0" text-alignment="center" transparent="true"/>
    <view class="CView" custom-view-name="Enable" origin="787, 201" size="125, 125"/>
    <!-- Lever up = ON; lever down = OFF. Text is outside the artwork and never intercepts mouse events. -->
    <view class="CTextLabel" origin="819, 195" size="60, 18" title="ON" mouse-enabled="false" transparent="true" back-color="Background" font="~ NormalFontSmall" font-color="PanelTitle" frame-width="0" text-alignment="center"/>
    <view class="CTextLabel" origin="819, 324" size="60, 18" title="OFF" mouse-enabled="false" transparent="true" back-color="Background" font="~ NormalFontSmall" font-color="PanelTitle" frame-width="0" text-alignment="center"/>
    <view class="CTextLabel" origin="789, 358" size="120, 22" title="FREEVERB" mouse-enabled="false" transparent="true" back-color="Background" font="~ NormalFontSmall" font-color="Muted" frame-width="0" text-alignment="center"/>
